#!/bin/sh

PROTECTED_BRANCH="release/production-live"
ALLOWED_USER='SANJEEV-BUI0136\sanjeev_brightui'

CURRENT_BRANCH=$(git branch --show-current)
CURRENT_USER=$(git config user.name)

if [ "$CURRENT_BRANCH" = "$PROTECTED_BRANCH" ]; then

    if [ "$CURRENT_USER" != "$ALLOWED_USER" ]; then
        echo ""
        echo "=============================================="
        echo "❌ Production merge blocked"
        echo "=============================================="
        echo ""
        echo "Only this Git user can merge into:"
        echo "$PROTECTED_BRANCH"
        echo ""
        echo "Allowed user:"
        echo "$ALLOWED_USER"
        echo ""
        echo "Current Git user:"
        echo "$CURRENT_USER"
        echo ""

        exit 1
    fi

    echo ""
    echo "✅ Production merge allowed for $CURRENT_USER"
    echo ""
fi

exit 0